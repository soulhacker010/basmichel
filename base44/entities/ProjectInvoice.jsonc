{
  "name": "ProjectInvoice",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "Gekoppeld project-ID"
    },
    "invoice_number": {
      "type": "string",
      "description": "Factuurnummer (gelijk aan projectnummer)"
    },
    "client_id": {
      "type": "string",
      "description": "Gekoppelde klant-ID"
    },
    "recipient_client_ids": {
      "type": "array",
      "description": "Lijst van klant-IDs die de factuur ontvangen",
      "items": {
        "type": "string"
      }
    },
    "client_name": {
      "type": "string",
      "description": "Naam van de klant"
    },
    "client_email": {
      "type": "string",
      "description": "E-mail van de klant"
    },
    "client_address": {
      "type": "string",
      "description": "Adres van de klant"
    },
    "invoice_date": {
      "type": "string",
      "format": "date",
      "description": "Factuurdatum (wordt automatisch gezet bij status Klaar)"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Vervaldatum (factuurdatum + 14 dagen)"
    },
    "items": {
      "type": "array",
      "description": "Factuuritems",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number",
      "description": "Subtotaal (voor korting)"
    },
    "discount_amount": {
      "type": "number",
      "default": 0,
      "description": "Kortingsbedrag (vast bedrag)"
    },
    "vat_percentage": {
      "type": "number",
      "default": 21,
      "description": "BTW percentage"
    },
    "vat_amount": {
      "type": "number",
      "description": "BTW bedrag"
    },
    "total_amount": {
      "type": "number",
      "description": "Totaalbedrag (inclusief BTW, na korting)"
    },
    "status": {
      "type": "string",
      "enum": [
        "concept",
        "verzonden",
        "betaald",
        "verlopen"
      ],
      "default": "concept",
      "description": "Factuurstatus"
    },
    "paid_date": {
      "type": "string",
      "format": "date",
      "description": "Betaaldatum"
    },
    "template_id": {
      "type": "string",
      "description": "Gebruikt sjabloon-ID"
    },
    "mollie_payment_link_id": {
      "type": "string",
      "description": "Mollie payment link ID"
    },
    "mollie_payment_link_url": {
      "type": "string",
      "description": "Mollie payment link URL"
    },
    "bank_account_name": {
      "type": "string",
      "description": "Naam op bankrekening"
    },
    "reminder_sent": {
      "type": "boolean",
      "default": false,
      "description": "Of de betalingsherinnering al verstuurd is"
    },
    "cc_emails": {
      "type": "string",
      "description": "CC e-mailadressen (kommagescheiden)"
    }
  },
  "required": [
    "project_id",
    "invoice_number"
  ]
}